{
  "name": "splayer",
  "version": "3.1.4",
  "description": "A minimalist music player",
  "author": "imsyy",
  "home": "https://imsyy.top",
  "github": "https://github.com/SPlayer-Dev/SPlayer",
  "blog": "https://blog.imsyy.top",
  "repository": "github:SPlayer-Dev/SPlayer",
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "type": "module",
  "scripts": {
    "api": "tsx server/index.ts",
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm typecheck:web && pnpm typecheck:server",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json --composite false",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@applemusic-like-lyrics/core": "^0.5.1",
    "@applemusic-like-lyrics/lyric": "^1.0.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.4.0",
    "@imsyy/color-utils": "^1.0.2",
    "@material/material-color-utilities": "^0.4.0",
    "@neteasecloudmusicapienhanced/api": "^4.34.3",
    "@pixi/app": "^7.4.3",
    "@pixi/core": "^7.4.3",
    "@pixi/display": "^7.4.3",
    "@pixi/filter-blur": "^7.4.3",
    "@pixi/filter-bulge-pinch": "^5.1.1",
    "@pixi/filter-color-matrix": "^7.4.3",
    "@pixi/sprite": "^7.4.3",
    "@unblockneteasemusic/server": "^0.28.0",
    "@vueuse/core": "^14.3.0",
    "@vueuse/integrations": "^14.3.0",
    "axios": "^1.17.0",
    "axios-retry": "^4.5.0",
    "change-case": "^5.4.4",
    "dayjs": "^1.11.21",
    "fastify": "^5.8.5",
    "file-saver": "^2.0.5",
    "fuse.js": "^7.4.1",
    "github-markdown-css": "^5.9.0",
    "js-cookie": "^3.0.8",
    "jss": "^10.10.0",
    "jss-preset-default": "^10.10.0",
    "localforage": "^1.10.0",
    "lodash-es": "^4.18.1",
    "marked": "^16.4.2",
    "md5": "^2.3.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "plyr": "^3.8.4",
    "sortablejs": "^1.15.7",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/emscripten": "^1.41.5",
    "@types/file-saver": "^2.0.7",
    "@types/js-cookie": "^3.0.6",
    "@types/md5": "^2.3.6",
    "@types/node": "^24.13.0",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "naive-ui": "2.43.2",
    "prettier": "^3.8.3",
    "sass": "^1.100.0",
    "terser": "^5.48.0",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.5",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-wasm": "^3.6.0",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0",
    "vue-tsc": "^3.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@applemusic-like-lyrics/core",
      "@applemusic-like-lyrics/lyric",
      "esbuild",
      "vue-demi"
    ]
  }
